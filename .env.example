# SecurePulse environment
#
# Copy to .env.local for development:   cp .env.example .env.local
#
# The app runs with NOTHING set. Every integration degrades to a clearly
# labelled disabled state rather than crashing, so you can clone, install,
# migrate and scan without obtaining a single credential.
#
# In production, APP_SECRET and CRON_SECRET are required and the server
# refuses to start without them.

# ---------------------------------------------------------------- required

# Signs session-token lookups and DNS verification tokens.
# Rotating it logs everyone out, which is intended.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Shared secret for the scheduled-scan endpoint. Without it, anyone could
# drive our outbound scanning by calling /api/cron/scan.
# Generate the same way as APP_SECRET.
CRON_SECRET=

# Absolute origin. Used in emails, Stripe redirect URLs and canonical links.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- database

# Leave BLANK for local development. The app then runs PGlite, which is real
# Postgres compiled to WASM against a local directory, so there is nothing to
# install and nothing to configure.
#
# Set it in production to any Postgres server (Neon, Supabase, RDS, Docker).
# The same migrations run against both.
#   DATABASE_URL=postgresql://user:password@host:5432/securepulse?sslmode=require
DATABASE_URL=

# Where PGlite keeps its data when DATABASE_URL is blank.
PGLITE_DATA_DIR=.data/pg

# ---------------------------------------------------------------- payments

# Billing is only enabled when BOTH the secret key and the webhook secret are
# present. A key without a webhook secret is worse than no billing at all:
# checkout would succeed and the subscription would never be recorded.
#
# Use a test key (sk_test_...) until you are ready to charge real money. The
# UI reads the key prefix and says which mode it is in.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Recurring price IDs created in the Stripe dashboard.
# The plan a customer receives is derived from the price that was billed,
# never from anything the client sends.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=

# ------------------------------------------------------------------- email

# Without a key, every message is still written to the `emails` table with its
# full body. That is the dev inbox, and it keeps the flows testable. Nothing
# is transmitted and nothing claims it was.
RESEND_API_KEY=
EMAIL_FROM="SecurePulse <alerts@yourdomain.com>"

# ---------------------------------------------------------------------- ai

# Powers the written remediation summary on reports. Without a key, a
# deterministic template built from the same findings is used instead, so the
# feature degrades in polish rather than in correctness.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Hard ceiling on tokens per report. This is the only per-report model cost.
ANTHROPIC_MAX_TOKENS=1400

# --------------------------------------------------------------- scanner

# Per-request network timeout, milliseconds.
SCAN_TIMEOUT_MS=10000
# Hard cap on HTTP requests a single scan may issue. Abuse guardrail.
SCAN_MAX_REQUESTS=24
SCAN_USER_AGENT="SecurePulseBot/1.0 (+https://securepulse.app/bot; passive security posture check)"
